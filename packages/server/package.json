{
  "name": "@lanternwood/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative game server: fixed-tick simulation, sessions, persistence, WebSocket transport.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --external:ws --sourcemap --outfile=dist/main.js",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@lanternwood/shared": "*",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0"
  }
}
