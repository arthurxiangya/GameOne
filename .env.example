# Copy to .env (or export) to override server defaults. Every value is optional.
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
CLIENT_DIST=./packages/client/dist
WORLD_SEED=2026
TICK_RATE=20
SNAPSHOT_EVERY_TICKS=1
MAX_PLAYERS=64
INTEREST_RADIUS=80
AUTOSAVE_SECONDS=30
DAY_LENGTH_SECONDS=480
LOG_LEVEL=info
# Comma-separated list. Empty allows any origin (fine for local play).
ALLOWED_ORIGINS=
